# Copy to backend/.env for `make backend` or keep at the root for `docker compose`.
# Every value here is a local-development default; nothing in this file is a secret worth protecting.
# The full key list with rules lives in docs/OPERATIONS.md ("Configuration").

# --- Core (local) ---
SERVER=development
API_PORT=8090
GATEWAY_ENVIRONMENT=test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=payminto
POSTGRES_USERNAME=payminto
POSTGRES_PASSWORD=payminto-development-db
POSTGRES_SSL_MODE=disable
POSTGRES_SCHEMA_MODE=auto-migrate
REDIS_URL=redis://localhost:6379
BLOCKCHAIN_NETWORK_TYPE=testnet
JWT_SECRET=payminto-development-jwt-secret-not-for-production
CUSTODY_ENABLED=false

# --- Attestations: Chainlink CRE (docs/cre/SPEC.md, docs/cre/OPERATIONS.md) ---
# Off by default. With CRE_ENABLED=false the gateway is byte-for-byte what it is without the module.
CRE_ENABLED=false
# none | mock | chainlink. mock is refused in staging/production and under GATEWAY_ENVIRONMENT=live.
CRE_PROVIDER=none
# CRE chain selector name of the attestation chain (Base Sepolia for test, Base for live).
CRE_CHAIN=ethereum-testnet-sepolia-base-1
# The gateway's own RPC for reading the consumer contract; attestations are never taken from a callback.
CRE_CHAIN_RPC_URL=
# GatewayAttestations consumer contract and the KeystoneForwarder it trusts (deployed by you, ticket 22).
CRE_CONSUMER_ADDRESS=
CRE_FORWARDER_ADDRESS=
# EVM address that owns the deployed workflows; every report must carry it. Per-kind overrides:
# CRE_WORKFLOW_OWNER_SOLVENCY, CRE_WORKFLOW_OWNER_DEPOSIT_FINALITY, CRE_WORKFLOW_OWNER_CONVERSION_REFERENCE.
CRE_WORKFLOW_OWNER=
# Chainlink CRE gateway for the HTTP trigger.
CRE_GATEWAY_URL=https://01.gateway.zone-a.cre.chain.link
# 32-byte hex workflow ids from `cre workflow deploy`; one per workflow.
CRE_WORKFLOW_ID_SOLVENCY=
CRE_WORKFLOW_ID_DEPOSIT_FINALITY=
CRE_WORKFLOW_ID_CONVERSION_REFERENCE=
# Workflow names as in each workflow.yaml; the Keystone name in every report is derived from them
# (sha256, first ten hex characters) and must equal the contract's binding.
CRE_WORKFLOW_NAME_SOLVENCY=solvency
CRE_WORKFLOW_NAME_DEPOSIT_FINALITY=deposit-finality
CRE_WORKFLOW_NAME_CONVERSION_REFERENCE=conversion-reference
# Reference to the trigger-signing key held by the signer service. A raw private key here is refused.
CRE_TRIGGER_SIGNER=keyring://cre-trigger
# This deployment's public API base URL; gatewayId = keccak256 of it. Required for chainlink.
CRE_PUBLIC_BASE_URL=
# Per-workflow bearer credentials for the pull and push routes; generate each with `openssl rand -hex 32`
# (at least 32 characters) and upload to the Vault DON with `cre secrets create`. The gateway keeps only a
# SHA-256 of each and compares in constant time. Unset refuses that workflow's routes.
CRE_READ_TOKEN_SOLVENCY=
CRE_READ_TOKEN_DEPOSIT_FINALITY=
CRE_READ_TOKEN_CONVERSION_REFERENCE=
# Schedules. Minimums: 1m, 30s, 5s. A workflow reads stale after two intervals without a verified record.
CRE_SOLVENCY_INTERVAL=1h
CRE_FINALITY_BATCH_INTERVAL=60s
CRE_POLL_INTERVAL=30s
# Finality: the RPC's finalized tag is the bound when served; otherwise latest minus this many blocks.
# 0 refuses that fallback (nothing is read until the tag works). Defaults to 12 in staging and production,
# where 0 is refused.
CRE_VERIFY_CONFIRMATIONS=0
# Set when CRE_FORWARDER_ADDRESS is a mock or simulation forwarder (the simulate tier): every record is then
# marked simulated and never shown as a production attestation. Refused in staging and production, as are the
# simulator's fixed workflow id (0x11..11) and owner (0xaa..aa) in CRE_WORKFLOW_ID_* and CRE_WORKFLOW_OWNER*.
CRE_FORWARDER_SIMULATED=false
# Serves /api/v1/public/attestations/:id and the unauthenticated liabilities snapshot.
CRE_PUBLIC_VERIFY_ENABLED=true
# Extra asset decimals as CODE:n,... for assets the built-in table omits; unknown assets are left out, never guessed.
CRE_ASSET_DECIMALS=
