# Payminto — payminto.io (landing), app.payminto.io (dashboard), checkout.payminto.io (hosted checkout)
# Upstreams run on loopback; nginx is the only public listener.

upstream payminto_api      { server 127.0.0.1:8090; keepalive 32; }
upstream payminto_landing  { server 127.0.0.1:3001; keepalive 16; }
upstream payminto_checkout { server 127.0.0.1:3002; keepalive 16; }
upstream payminto_app      { server 127.0.0.1:3003; keepalive 16; }

proxy_http_version 1.1;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---------------------------------------------------------------- landing
server {
    server_name payminto.io www.payminto.io;

    # ACME HTTP-01 challenge (certbot webroot); must stay reachable over plain HTTP.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type "text/plain";
        try_files $uri =404;
    }

    client_max_body_size 2m;

    location / {
        proxy_pass http://payminto_landing;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/payminto.io/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/payminto.io/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}

# ---------------------------------------------------------- merchant app
server {
    server_name app.payminto.io;

    # ACME HTTP-01 challenge (certbot webroot); must stay reachable over plain HTTP.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type "text/plain";
        try_files $uri =404;
    }

    client_max_body_size 20m;

    # The Go gateway owns the versioned API; Next owns /api/auth/* only.
    location ~ ^/api/v[12](/|$) {
        proxy_pass http://payminto_api;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        # Server-sent events must not be buffered.
        proxy_buffering off;
        proxy_cache off;
    }

    location = /healthz { proxy_pass http://payminto_api; proxy_set_header Host $host; }
    location = /readyz  { proxy_pass http://payminto_api; proxy_set_header Host $host; }

    # Prometheus exposition stays private.
    location = /metrics {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://payminto_api;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://payminto_app;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/payminto.io/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/payminto.io/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

# -------------------------------------------------------- hosted checkout
server {
    server_name checkout.payminto.io;

    # ACME HTTP-01 challenge (certbot webroot); must stay reachable over plain HTTP.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type "text/plain";
        try_files $uri =404;
    }

    client_max_body_size 2m;

    # Checkout reaches the gateway server-side; the browser only talks to Next,
    # including the SSE stream at /api/payment/:id/events.
    location / {
        proxy_pass http://payminto_checkout;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_buffering off;
        proxy_cache off;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/payminto.io/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/payminto.io/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = www.payminto.io) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = payminto.io) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name payminto.io www.payminto.io;
    return 404; # managed by Certbot




}
server {
    if ($host = app.payminto.io) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name app.payminto.io;
    return 404; # managed by Certbot


}
server {
    if ($host = checkout.payminto.io) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name checkout.payminto.io;
    return 404; # managed by Certbot


}