[Unit]
Description=Payminto gateway API (Go)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/payminto/backend
EnvironmentFile=/home/ubuntu/payminto/backend/.env
ExecStart=/home/ubuntu/payminto/backend/bin/payminto-server
Restart=always
RestartSec=5
# Only loopback listeners; no privileged ports needed.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/payminto/backend
StandardOutput=append:/var/log/payminto/api.log
StandardError=append:/var/log/payminto/api.log

[Install]
WantedBy=multi-user.target
