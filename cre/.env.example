# Copy to cre/.env for cre workflow simulate. cre/.env is git-ignored; no gateway code reads it.
# Simulation signing key: the CLI's default simulation key is used when this is unset. For a --broadcast run
# against a local Anvil, use one of Anvil's printed dev keys (they are public and hold no real funds).
CRE_ETH_PRIVATE_KEY=
# RPC per target (project.yaml). The local one is your Anvil.
CRE_LOCAL_EVM_RPC_URL=http://127.0.0.1:8545
CRE_STAGING_EVM_RPC_URL=https://sepolia.base.org
CRE_PRODUCTION_EVM_RPC_URL=
# Secret values for simulation, named as in secrets.yaml. The gateway's CRE_READ_TOKEN_SOLVENCY goes here.
SOLVENCY_READ_TOKEN=
CUSTODIAN_API_KEY_VALUE=
